{
  "name": "muxyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "dev": "pnpm --filter @muxyard/desktop dev",
    "dev:remote": "pnpm --filter @muxyard/remote-web dev",
    "tauri": "node scripts/doctor.mjs && pnpm --filter @muxyard/desktop tauri",
    "build": "pnpm -r build",
    "build:host": "cargo build --locked --release -p muxyard-host",
    "build:desktop": "pnpm tauri build --no-bundle",
    "format": "prettier --write \"*.{json,js,ts,yaml}\" README.md apps packages scripts tests",
    "format:check": "prettier --check \"*.{json,js,ts,yaml}\" README.md apps packages scripts tests",
    "lint": "eslint apps packages scripts eslint.config.js prettier.config.js vitest.config.ts --max-warnings 0",
    "typecheck": "pnpm -r typecheck && tsc --project tsconfig.node.json",
    "test": "node --test scripts/doctor.test.mjs scripts/contracts.test.mjs scripts/ci/license-report.test.mjs scripts/ci/platform-report.test.mjs scripts/ci/workflow-safety.test.mjs && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
